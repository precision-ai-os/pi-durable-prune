{
  "name": "pi-durable-prune",
  "version": "0.2.2",
  "description": "Context pruning for pi-durable agents: set aside large earlier tool results behind a recall ref without breaking the prompt cache.",
  "license": "MIT",
  "author": {
    "name": "Precision",
    "url": "https://getprecision.ai"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "pi": {
    "image": "https://raw.githubusercontent.com/precision-ai-os/pi-durable-prune/main/docs/long-chat.png"
  },
  "keywords": ["pi-package", "pi", "pi-durable", "agent", "llm", "context", "pruning", "prompt-cache"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/precision-ai-os/pi-durable-prune.git"
  },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@earendil-works/chord": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-durable": "^1.5.2"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@types/node": "24.19.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
